 #include <daemon.h>
 #include <library.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+
+/* Read OTP from /etc/ipsec.otp, trimming trailing newline/CR.
+ * One-shot: the file is unlinked after a successful read so stale
+ * codes are never reused on subsequent XAuth challenges. */
+static int read_otp_file(const char *path, char *buf, size_t buflen)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return -1;
+    size_t r = fread(buf, 1, buflen - 1, f);
+    fclose(f);
+    while (r > 0 && (buf[r-1] == '\n' || buf[r-1] == '\r')) r--;
+    buf[r] = '\0';
+
+    /* One-shot: delete the file after read so subsequent XAuth rounds
+     * don't replay a stale token. This matters because FortiGate may
+     * retry the challenge once before declaring auth failure. */
+    if (r > 0) {
+        unlink(path);
+    }
+    return (int)r;
+}
 
