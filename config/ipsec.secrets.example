# Copy to config/ipsec.secrets, fill in, then: chmod 600 config/ipsec.secrets
# Never commit the real file. The emailed OTP is NOT stored here; you type it at connect time.

# Pre-shared key of the gateway (one line, shared by all profiles on that gateway)
: PSK "<PRE_SHARED_KEY>"

# One line per user = the xauth_identity of a conn in ipsec.conf
<USERNAME>       : XAUTH "<PASSWORD>"
<OTHER_USERNAME> : XAUTH "<OTHER_PASSWORD>"
